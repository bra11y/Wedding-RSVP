# Where RSVP answers are sent (JSON POST). Copy to .env and fill in.
# Quickest free option: create a form at https://formspree.io and paste its endpoint:
#   PUBLIC_RSVP_ENDPOINT=https://formspree.io/f/xxxxxxx
# For GitHub Pages, add it as a repository variable named PUBLIC_RSVP_ENDPOINT instead.
PUBLIC_RSVP_ENDPOINT=
